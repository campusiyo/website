# ============================================================
# Campusiyo Frontend — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
#
# Usage:
#   cp .env.example .env.local
#   # Edit .env.local with your actual values

# ── Backend API ──────────────────────────────────────────────
# The Spring Boot backend base URL (no trailing slash).
# Next.js rewrites /api/* to this URL server-side.
# In development: http://localhost:8080
# In production:  your actual backend URL or internal network URL
BACKEND_URL=http://localhost:8080

# ── Public Site URL ─────────────────────────────────────────
# Used for canonical URLs, OG metadata, and absolute links.
NEXT_PUBLIC_SITE_URL=https://campusiyo.in

# ── Google OAuth (optional) ─────────────────────────────────
# Client ID for Google Sign-In integration.
# Obtain from: https://console.cloud.google.com/
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── Search Engine Verification ───────────────────────────────
# Google Search Console verification token.
# Already hardcoded in layout.tsx; use this to override if needed.
NEXT_PUBLIC_GOOGLE_VERIFICATION=QHr6G2FEItujyjrSoZirsfOfBqQQJwA8CxgcTPntk7I
